# Copy to .env.local for local development. Never commit real secrets.
APP_URL=http://localhost:3000
# Leave DATABASE_URL empty to use the embedded PGlite database in ./.data/pglite
DATABASE_URL=
# 32+ random characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
EMAIL_MODE=console
# Payments stay in test mode until gate G-PAY is complete (RETENUM_PRODUCT_DECISIONS.md)
PAYMENTS_MODE=test
